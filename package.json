{
  "name": "waitlist-fill-agent",
  "version": "1.0.0",
  "description": "Fills cancelled appointment slots from the waiting list of a fictional dental clinic (LangGraph.js + Outlook Calendar MCP + WA-AKG)",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "typecheck": "tsc -p .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/reset.ts",
    "calendar:sync": "node --env-file-if-exists=.env scripts/sync-calendar.ts",
    "trigger": "node --env-file-if-exists=.env scripts/trigger-cancellation.ts",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "eval": "node --env-file-if-exists=.env scripts/run-evals.ts",
    "eval:judge": "node --env-file-if-exists=.env scripts/run-evals.ts --judge",
    "sim:fill": "node --env-file-if-exists=.env scripts/fill-sim.ts",
    "fake-graph": "node --env-file-if-exists=.env scripts/fake-graph.ts"
  },
  "keywords": [
    "langgraph",
    "mcp",
    "agents",
    "whatsapp",
    "outlook"
  ],
  "type": "module",
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "fastify": "^5.12.8",
    "openai": "^5.23.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "promptfoo": "^0.125.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT"
}
