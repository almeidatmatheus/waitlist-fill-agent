# ---------------------------------------------------------------------------
# Waitlist Fill Agent - example configuration (no real credentials)
# Copy to .env and adjust. Every value here is a placeholder.
# ---------------------------------------------------------------------------

# development | test | production. Dev-only endpoints exist only in development/test.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL (docker compose maps the container to host port 5433)
DATABASE_URL=postgres://aar:aar_dev_password@localhost:5433/aar
TEST_DATABASE_URL=postgres://aar:aar_dev_password@localhost:5433/aar_test

# Bearer token required for every non-public endpoint (GET /appointments, /waitlist, /workflows, /dev/*)
# The placeholder only works for a local demo. It is refused in production, on a non-loopback HOST,
# with MESSAGING_PROVIDER=wa-akg and with change notifications on. Generate one: openssl rand -hex 32
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# Clinic
CLINIC_NAME=Bright Smile Dental (fictional)
# Fictional number (Ofcom drama range) shown to patients when a human is needed
CLINIC_PHONE_DISPLAY=020 7946 0000
CLINIC_TIMEZONE=Europe/London
# Name of the dedicated Outlook calendar used for clinic appointments (empty = default calendar)
CLINIC_CALENDAR_NAME=Bright Smile Clinic
OFFER_TTL_MINUTES=30
# Offer cascade: how many patients can hold an offer for the same freed slot at once (1 = one at a time).
OFFER_CASCADE_SIZE=3
# Minutes before the offer is widened to one more patient (0 = offer to the whole cascade at once).
OFFER_WIDEN_AFTER_MINUTES=5
MIN_LEAD_TIME_MINUTES=60
MAX_CLARIFICATION_TURNS=2
# Bookable hours for patient reschedules (clinic time zone)
CLINIC_OPENING_HOURS=mon-fri 09:00-18:00
# How long a cancel/reschedule proposal waits for the patient's confirmation
PATIENT_REQUEST_TTL_MINUTES=30

# Background loops (milliseconds). Set CANCELLATION_POLL_MS=0 to disable polling.
CANCELLATION_POLL_MS=60000
CANCELLATION_CONFIRMATIONS=2
CANCELLATION_LOOKAHEAD_DAYS=30
SWEEP_INTERVAL_MS=15000
# Polling interval while Graph change notifications are healthy (see OUTLOOK_MCP_NOTIFY_URL below)
CANCELLATION_FALLBACK_POLL_MS=300000
# Notifications arriving within this window share one calendar listing
CALENDAR_NOTIFY_DEBOUNCE_MS=2000

# ---------------- LLM ----------------
# openai | mock  (mock = deterministic rule-based interpreter, no network, used by tests/evals)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional, for cost estimation only (USD per 1M tokens)
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
LLM_TIMEOUT_MS=20000
# Evals: 'openai' runs the Promptfoo scenarios against the real model (default: rule-based mock)
EVAL_LLM=
# Optional judge model for npm run eval:judge (default: OPENAI_MODEL)
EVAL_JUDGE_MODEL=

# ---------------- Jev (TypeSafe System One) ----------------
# Fast, calibrated, typed decisions: interprets offer replies and judges confirmations.
# auto = enabled when TYPESAFE_API_KEY is set; off = never (pure LLM path).
JEV_MODE=auto
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_URL=https://api.typesafe.ai
TYPESAFE_TIMEOUT_MS=2500
# USD per 1M input tokens (output tokens are free)
TYPESAFE_PRICE_INPUT_PER_1M=0.042
# Below these confidences the decision falls back to the LLM (accept has a higher bar: it books)
JEV_MIN_CONFIDENCE=0.7
JEV_MIN_ACCEPT_CONFIDENCE=0.85

# ---------------- Calendar (existing Outlook Calendar MCP) ----------------
# mock | mcp
CALENDAR_PROVIDER=mock
# stdio | http
OUTLOOK_MCP_TRANSPORT=stdio
OUTLOOK_MCP_COMMAND=node
# Absolute path to a local clone of https://github.com/almeidatmatheus/outlook-calendar-lite-mcp (src/main.ts)
OUTLOOK_MCP_PATH=
# Passed through to the MCP process (stdio mode)
OUTLOOK_MCP_CLIENT_ID=
OUTLOOK_MCP_TENANT=common
OUTLOOK_MCP_LOGIN=device
# Optional: Microsoft Graph change notifications, so a cancellation is seen in seconds instead of at the next poll.
# Public HTTPS URL of THIS app ending in /webhooks/graph, and a random shared secret (16 to 128 characters).
# Set both or neither. With a remote MCP, set the same two variables on that server too.
OUTLOOK_MCP_NOTIFY_URL=
OUTLOOK_MCP_NOTIFY_SECRET=
# Remote (HTTP) mode only
OUTLOOK_MCP_URL=
OUTLOOK_MCP_BEARER_TOKEN=
MCP_CALL_TIMEOUT_MS=20000
# Tests: path to a local MCP clone for the real-MCP integration test (default: ../outlook-calendar-lite-mcp/src/main.ts)
OUTLOOK_MCP_TEST_PATH=

# ---------------- WhatsApp (WA-AKG gateway) ----------------
# mock | wa-akg
MESSAGING_PROVIDER=mock
WA_AKG_BASE_URL=http://localhost:3001
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=clinic-test
# HMAC secret configured on the WA-AKG webhook (X-Webhook-Signature: sha256=...). The placeholder is refused like the one above.
WA_AKG_WEBHOOK_SECRET=change-me-webhook-secret
# Real messages are ONLY ever sent to these E.164 numbers (comma separated). Required for wa-akg mode.
WHATSAPP_ALLOWED_NUMBERS=
# Optional: POSTed when a conversation is handed off to a human (JSON). Empty = no notifier configured.
HUMAN_HANDOFF_WEBHOOK_URL=
